      "devalue": "^5.6.4",
      "esbuild": ">=0.25.0",
      "fast-uri@3": "^3.1.6",
      "flatted": "^3.4.2",
      "follow-redirects": "^1.16.0",
      "form-data": "^4.0.6",
      "h3@1": "^1.15.9",
      "js-yaml@3": "^3.15.2",
